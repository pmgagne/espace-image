{
    "name": "espace-image",
    "version": "1.0.0",
    "description": "Digital photo frame web application with calendar integration",
    "private": true,
    "scripts": {
        "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
        "lint:html": "html-validate 'app/templates/**/*.html'",
        "lint:css": "stylelint 'app/static/css/**/*.css'",
        "lint:js": "eslint 'app/static/js/**/*.js'",
        "lint:js:legacy": "eslint 'app/templates/legacy/**/*.html' 'app/static/js/legacy.js'",
        "lint:fix": "npm run lint:css -- --fix && npm run lint:js -- --fix",
        "format": "prettier --write 'app/static/**/*.{css,js}'",
        "check": "npm run lint"
    },
    "devDependencies": {
        "@html-validate/stylish": "^4.2.0",
        "eslint": "^8.57.1",
        "eslint-plugin-compat": "^4.2.0",
        "eslint-plugin-html": "^8.1.4",
        "html-validate": "^8.20.0",
        "prettier": "^3.2.5",
        "stylelint": "^16.6.0",
        "stylelint-config-standard": "^36.0.0",
        "stylelint-no-unsupported-browser-features": "^8.0.1"
    },
    "browserslist": [
        "iOS >= 9.3",
        "last 2 versions",
        "> 1%",
        "not dead"
    ]
}
