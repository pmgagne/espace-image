# App Configuration
APP_TITLE="Slideshow Dashboard"
DEBUG=True

# Weather API (OpenWeatherMap)
# Get a key from https://openweathermap.org/api
WEATHER_API_KEY=your_key_here
WEATHER_LAT=45.5017
WEATHER_LON=-73.5673

# Calendar
# Your public or private iCloud calendar ICS link
ICLOUD_CALENDAR_URL=https://pXX-caldav.icloud.com/...

# Paths
# Directory where images and SQLite DB are stored
DATA_DIR=./data
