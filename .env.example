# Espace-Image Environment Configuration

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode (WARNING: Never enable in production)
WEBAPP_DEBUG=false

# Database URL - defaults to SQLite in data/ directory
DATABASE_URL=sqlite:///data/espace_image.db

# Image Optimization (defaults: 800KB threshold, quality 82, min 60)
IMAGE_OPTIMIZE_MIN_BYTES=819200
IMAGE_JPEG_QUALITY=82
IMAGE_JPEG_MIN_QUALITY=60

# Timezone (IANA name, e.g., America/New_York)
TZ=America/Toronto

# caldav account to use
# Get your password from the icloud app password page.
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Optional provider hint for CalDAV sources. When set to `icloud` the
# application will enable Apple/iCloud-specific parsing fixes (used to
# work around Apple-generated ICS quirks). Leave empty or unset for
# automatic URL-based detection.
CALDAV_PROVIDER=icloud
# When true, attempt to disable HTTP/3 for CalDAV HTTP client negotiation
# to avoid HTTP/3 transport issues with some servers.
CALDAV_DISABLE_HTTP3=true


# SECURITY NOTE: This app has NO authentication.
# Deploy behind a reverse proxy with auth or on trusted network only.

# Optional: Delay between syncing individual calendar sources during a background
# run. Value is in minutes and may be fractional (e.g. 0.5 = 30 seconds).
# Default: 0 (no delay).
BACKGROUND_SYNC_DELAY_MINUTES=0
# Default delay used when BACKGROUND_SYNC_DELAY_MINUTES is unset or <= 0
# Value is in minutes. Default: 120
BACKGROUND_SYNC_DEFAULT_MINUTES=120

# Optional: Retention window (in days) for AlarmEvent rows. Past alarm/event
# rows whose trigger_time is older than this are purged on each background sync
# (and by `espima alarms purge`). Default: 30
ALARM_RETENTION_DAYS=30
